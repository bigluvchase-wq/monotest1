# Добавьте эти строки в существующий .env. Не заменяйте настройки оплаты/почты.
# Сначала проверьте подключение, затем установите VOICE_AI_ENABLED=1.
VOICE_AI_ENABLED=0
YANDEX_FOLDER_ID=your_folder_id
YANDEX_API_KEY=your_secret_api_key
# По умолчанию используется gpt://<YANDEX_FOLDER_ID>/yandexgpt-5.1.
# YANDEX_MODEL_URI=gpt://your_folder_id/yandexgpt-5.1
VOICE_AI_DAILY_LIMIT=50
VOICE_AI_GLOBAL_DAILY_LIMIT=500
VOICE_AI_CONCURRENCY=4
